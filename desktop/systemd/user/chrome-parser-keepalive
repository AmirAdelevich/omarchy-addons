#!/usr/bin/bash
set -u

if [[ -x /opt/google/chrome/google-chrome ]]; then
  chrome=/opt/google/chrome/google-chrome
elif command -v google-chrome-stable >/dev/null 2>&1; then
  chrome=$(command -v google-chrome-stable)
elif command -v google-chrome >/dev/null 2>&1; then
  chrome=$(command -v google-chrome)
else
  printf 'Не найден Google Chrome. Установи его и включи автозапуск повторно.\n' >&2
  exit 1
fi

while true; do
  if ! pgrep -u "$(id -u)" -x chrome >/dev/null 2>&1; then
    "$chrome" --no-first-run >/dev/null 2>&1 &
    chrome_launcher_pid=$!
    for _ in {1..30}; do
      pgrep -u "$(id -u)" -x chrome >/dev/null 2>&1 && break
      sleep 1
    done
    wait "$chrome_launcher_pid" 2>/dev/null || true
  fi
  sleep 10
done
